# Green API Bot — Environment Variables
# Copy to .env.local for local development

# OpenAI API Key (optional — bot works in deterministic mode without it)
# Only needed if you want to use LLM for phrasing (facts still come from knowledge base)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Force deterministic mode (default: true)
# When true, bot uses only the deterministic engine — zero hallucinations guaranteed
# When false and OPENAI_API_KEY is set, bot uses LLM for phrasing but facts from KB
NEXT_PUBLIC_DETERMINISTIC=true